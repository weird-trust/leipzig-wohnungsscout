# Copy to .env.local. All values are server-only; never prefix them with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Resend: API key (reads received emails) and the signing secret (whsec_…) of
# the email.received webhook. Only needed when the webhook or capture script runs.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Basic Auth password for the dashboard (any username). Required: without it
# every page answers 503, in development and production.
DASHBOARD_PASSWORD=
